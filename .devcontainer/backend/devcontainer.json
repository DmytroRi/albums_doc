{
  "name": "albums-backend",
  "dockerComposeFile": [
    "../docker-compose.dev.yml"
  ],
  "service": "backend",
  "overrideCommand": true,
  "workspaceFolder": "/app",
  "forwardPorts": [
    3000,
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Flutter Frontend",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "remoteEnv": {
    "DATABASE_URL": "postgresql+psycopg://albums:albums@postgres:5432/albums"
  },
  "runServices": [
    "postgres",
    "backend"
  ],
  "shutdownAction": "none"
}
