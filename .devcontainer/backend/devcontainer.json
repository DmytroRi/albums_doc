{
  "name": "albums-backend",
  "dockerComposeFile": ["../../docker-compose.dev.yml"],
  "service": "backend",
  "workspaceFolder": "/app",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"],
      "launch": {
        "version": "0.2.0",
        "configurations": [
          {
            "name": "Backend: FastAPI (Debug)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
            "jinja": true,
            "justMyCode": true
          }
        ]
      }
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "remoteEnv": {
    "DATABASE_URL": "postgresql+psycopg://albums:albums@postgres:5432/albums"
  }
}