{
  "name": "albums-frontend",
  "dockerComposeFile": [
    "../docker-compose.dev.yml"
  ],
  "service": "frontend",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ]
    }
  },
  "postCreateCommand": "flutter pub get",
  "runServices": [
    "frontend"
  ],
  "shutdownAction": "none",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Flutter Frontend",
      "onAutoForward": "openBrowser"
    }
  }
}
