{
  "name": "albums-frontend",
  "dockerComposeFile": [
    "../../docker-compose.dev.yml"
  ],
  "service": "frontend",
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "alexisvt.flutter-snippets",
        "Nash.awesome-flutter-snippets",
        "localizely.flutter-intl"
      ],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter",
        "dart.checkForSdkUpdates": false,
        "dart.openDevTools": "flutter",
        "dart.debugExternalPackageLibraries": true,
        "dart.debugSdkLibraries": false,
        "dart.previewFlutterUiGuides": true,
        "dart.lineLength": 101,
        "dart.chromeExecutable": "/usr/bin/chromium",
        "editor.formatOnSave": true,
        "editor.rulers": [
          80,
          101
        ],
        "files.exclude": {
          "**/.dart_tool": true,
          "**/.packages": true,
          "**/build": true,
          "**/.flutter-plugins": true,
          "**/.flutter-plugins-dependencies": true
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.cwd": "/workspace",
        "flutter.experimentalRefactors": true
      }
    }
  },
  "forwardPorts": [
    3000,
    9222,
    "9100-9101"
  ],
  "portsAttributes": {
    "3000": {
      "label": "Flutter Web Server",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    },
    "9222": {
      "label": "Chrome Debug",
      "onAutoForward": "silent"
    },
    "9100-9101": {
      "label": "Flutter DevTools",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "flutter pub get",
  "remoteUser": "root",
  "overrideCommand": false
}
